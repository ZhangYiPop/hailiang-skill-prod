# Add these values to the API Deployment ConfigMap/Secret in the existing
# devops-dev.yaml and devops-prod.yaml supplied by operations.
HAILIANG_SCRIPT_EXECUTOR=remote
HAILIANG_REQUIRE_REMOTE_SANDBOX=true
HAILIANG_SANDBOX_ENDPOINT=http://${APP_NAME}-sandbox:8081
# Store this in the same Kubernetes Secret key used by sandbox-runner.yaml;
# do not put its real value in a ConfigMap or repository.
HAILIANG_SANDBOX_SHARED_TOKEN=<from-${APP_NAME}-sandbox-secret>
