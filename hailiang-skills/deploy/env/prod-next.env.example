# Copy to /etc/hailiang-skills/prod-next.env, replace placeholders, chmod 600.
HAILIANG_DEPLOY_ENV=prod-next
HAILIANG_RELEASE_VERSION=
HAILIANG_NODE_NAME=replace-with-hostname
HAILIANG_BIND_HOST=REPLACE_PRIVATE_IP
BACKEND_PORT=8016
WORKBENCH_PORT=8023
HAILIANG_FRONTEND_BIND_HOST=REPLACE_PRIVATE_IP
FRONTEND_PORT=5178
HAILIANG_PUBLIC_API_BASE_URL=http://REPLACE_PRIVATE_IP:8016
HAILIANG_CORS_ORIGINS=http://REPLACE_PRIVATE_IP:5178
HAILIANG_DATABASE_URL=postgresql+psycopg://hailiang_prod_next:REPLACE@127.0.0.1:5432/hailiang_skills_multi_profile_v1_next
HAILIANG_STORAGE_BACKEND=postgres
HAILIANG_REDIS_URL=redis://127.0.0.1:6379/4
HAILIANG_REDIS_KEY_PREFIX=hailiang:prod-next:
HAILIANG_MAX_SSE_CONNECTIONS=100
HAILIANG_STREAM_WORKERS=50
UVICORN_WORKERS=2
HAILIANG_LLM_RATE_LIMIT_QPS=45
HAILIANG_LLM_RATE_LIMIT_CAPACITY=1
HAILIANG_LOG_DIR=/var/lib/hailiang-skills/prod-next/logs
HAILIANG_STATE_DIR=/var/lib/hailiang-skills/prod-next/runtime
HAILIANG_SSE_RECORDING_ENABLED=false
HAILIANG_SSE_RECORDING_ROOT_DIR=/var/lib/hailiang-skills/prod-next/logs/sse_recording/sessions
HAILIANG_LOCAL_SESSION_CACHE_ENABLED=false
HAILIANG_AUDIT_RAW_CONTENT_ENABLED=false
HAILIANG_AUDIT_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_32_BYTE_BASE64URL_KEY
HAILIANG_AUDIT_KEY_ID=prod-next
HAILIANG_SECURITY_QUARANTINE_KEY=REPLACE_WITH_DISTINCT_32_BYTE_BASE64URL_KEY
HAILIANG_SECURITY_ADMIN_TOKEN=REPLACE_PROD_NEXT_ADMIN_TOKEN
ALIBABA_CLOUD_ACCESS_KEY_ID=REPLACE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=REPLACE
ALIYUN_SECURITY_REGION=cn-hangzhou
ALIYUN_SECURITY_ENDPOINT=green-cip.cn-hangzhou.aliyuncs.com
DASHSCOPE_API_KEY=REPLACE
HAILIANG_TEST_LLM_ENABLED=false
AGENT_SKILL_RUNTIME_CORE_PATH=/opt/agent-skill-runtime-core
PYTHONPATH=/opt/hailiang-skills/current-prod-next/src:/opt/agent-skill-runtime-core
