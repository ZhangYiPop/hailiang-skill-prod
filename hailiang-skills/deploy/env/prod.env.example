# Copy to /etc/hailiang-skills/prod.env, replace all placeholders, chmod 600.
HAILIANG_DEPLOY_ENV=prod
HAILIANG_RELEASE_VERSION=
HAILIANG_NODE_NAME=replace-with-hostname
# Must be the explicit BFF-reachable private address, never 0.0.0.0.
HAILIANG_BIND_HOST=REPLACE_PRIVATE_IP
BACKEND_PORT=8011
HAILIANG_FRONTEND_BIND_HOST=REPLACE_PRIVATE_IP
FRONTEND_PORT=4176
HAILIANG_PUBLIC_API_BASE_URL=http://REPLACE_PRIVATE_IP:8011
# Required only because this internal frontend calls the API from a browser.
HAILIANG_CORS_ORIGINS=http://REPLACE_PRIVATE_IP:4176
HAILIANG_DATABASE_URL=postgresql+psycopg://hailiang_prod:REPLACE@127.0.0.1:5432/hailiang_skills
HAILIANG_STORAGE_BACKEND=postgres
# Optional. Defaults to the URL above with the SQLAlchemy +psycopg suffix removed.
HAILIANG_PGDUMP_URL=
HAILIANG_REDIS_URL=redis://127.0.0.1:6379/2
HAILIANG_REDIS_KEY_PREFIX=hailiang:prod:
HAILIANG_MAX_SSE_CONNECTIONS=100
HAILIANG_STREAM_WORKERS=50
UVICORN_WORKERS=2
HAILIANG_LLM_RATE_LIMIT_QPS=45
HAILIANG_LLM_RATE_LIMIT_CAPACITY=1
HAILIANG_LOG_DIR=/var/lib/hailiang-skills/prod/logs
HAILIANG_STATE_DIR=/var/lib/hailiang-skills/prod/runtime
HAILIANG_SSE_RECORDING_ENABLED=false
HAILIANG_SSE_RECORDING_ROOT_DIR=/var/lib/hailiang-skills/prod/logs/sse_recording/sessions
HAILIANG_LOCAL_SESSION_CACHE_ENABLED=false
HAILIANG_AUDIT_RAW_CONTENT_ENABLED=false
HAILIANG_AUDIT_ENCRYPTION_KEY=REPLACE
HAILIANG_AUDIT_KEY_ID=prod
# A distinct 32-byte base64url key used only for encrypted moderation evidence.
HAILIANG_SECURITY_QUARANTINE_KEY=REPLACE
# Configure Alibaba Cloud Content Moderation. Without both credentials the
# application falls back to the broad local lexicon, which is less accurate.
ALIBABA_CLOUD_ACCESS_KEY_ID=REPLACE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=REPLACE
ALIYUN_SECURITY_REGION=cn-hangzhou
ALIYUN_SECURITY_ENDPOINT=green-cip.cn-hangzhou.aliyuncs.com
DASHSCOPE_API_KEY=REPLACE
AGENT_SKILL_RUNTIME_CORE_PATH=/opt/agent-skill-runtime-core
PYTHONPATH=/opt/hailiang-skills/current-prod/src:/opt/agent-skill-runtime-core
