# Copy to /etc/hailiang-skills/test.env, replace all placeholders, chmod 600.
HAILIANG_DEPLOY_ENV=test
HAILIANG_RELEASE_VERSION=
HAILIANG_NODE_NAME=replace-with-hostname
# Use the server's private IP when internal testers open the test page remotely.
HAILIANG_BIND_HOST=REPLACE_PRIVATE_IP
BACKEND_PORT=8010
HAILIANG_FRONTEND_BIND_HOST=REPLACE_PRIVATE_IP
FRONTEND_PORT=4175
HAILIANG_PUBLIC_API_BASE_URL=http://REPLACE_PRIVATE_IP:8010
HAILIANG_CORS_ORIGINS=http://REPLACE_PRIVATE_IP:4175
HAILIANG_DATABASE_URL=postgresql+psycopg://hailiang_test:REPLACE@127.0.0.1:5432/hailiang_skills_test
HAILIANG_STORAGE_BACKEND=postgres
HAILIANG_REDIS_URL=redis://127.0.0.1:6379/1
HAILIANG_REDIS_KEY_PREFIX=hailiang:test:
HAILIANG_MAX_SSE_CONNECTIONS=10
HAILIANG_STREAM_WORKERS=5
UVICORN_WORKERS=1
HAILIANG_LLM_RATE_LIMIT_QPS=5
HAILIANG_LLM_RATE_LIMIT_CAPACITY=1
HAILIANG_LOG_DIR=/var/lib/hailiang-skills/test/logs
HAILIANG_STATE_DIR=/var/lib/hailiang-skills/test/runtime
HAILIANG_SSE_RECORDING_ENABLED=true
HAILIANG_SSE_RECORDING_ROOT_DIR=/var/lib/hailiang-skills/test/logs/sse_recording/sessions
HAILIANG_LOCAL_SESSION_CACHE_ENABLED=true
HAILIANG_AUDIT_RAW_CONTENT_ENABLED=false
HAILIANG_AUDIT_ENCRYPTION_KEY=REPLACE
HAILIANG_AUDIT_KEY_ID=test
# A distinct 32-byte base64url key used only for encrypted moderation evidence.
HAILIANG_SECURITY_QUARANTINE_KEY=REPLACE
# Configure Alibaba Cloud Content Moderation. Without both credentials the
# application falls back to the broad local lexicon, which is less accurate.
ALIBABA_CLOUD_ACCESS_KEY_ID=REPLACE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=REPLACE
ALIYUN_SECURITY_REGION=cn-hangzhou
ALIYUN_SECURITY_ENDPOINT=green-cip.cn-hangzhou.aliyuncs.com
DASHSCOPE_API_KEY=REPLACE
AGENT_SKILL_RUNTIME_CORE_PATH=/opt/agent-skill-runtime-core
PYTHONPATH=/opt/hailiang-skills/current-test/src:/opt/agent-skill-runtime-core
