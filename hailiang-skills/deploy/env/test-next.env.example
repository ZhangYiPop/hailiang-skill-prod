# Copy to /etc/hailiang-skills/test-next.env, replace all placeholders, chmod 600.
# This is a parallel, isolated validation environment.  It never shares the
# existing test/prod database, Redis namespace, log directory, or state directory.
HAILIANG_DEPLOY_ENV=test-next
HAILIANG_RELEASE_VERSION=
HAILIANG_NODE_NAME=replace-with-hostname
HAILIANG_BIND_HOST=REPLACE_PRIVATE_IP
BACKEND_PORT=8010
WORKBENCH_PORT=8022
HAILIANG_FRONTEND_BIND_HOST=REPLACE_PRIVATE_IP
FRONTEND_PORT=5177
HAILIANG_PUBLIC_API_BASE_URL=http://REPLACE_PRIVATE_IP:8010
HAILIANG_CORS_ORIGINS=http://REPLACE_PRIVATE_IP:5177
HAILIANG_DATABASE_URL=postgresql+psycopg://hailiang_test_next:REPLACE@127.0.0.1:5432/hailiang_skills_test_multi_profile_v1_next
HAILIANG_STORAGE_BACKEND=postgres
HAILIANG_REDIS_URL=redis://127.0.0.1:6379/3
HAILIANG_REDIS_KEY_PREFIX=hailiang:test-next:
HAILIANG_MAX_SSE_CONNECTIONS=10
HAILIANG_STREAM_WORKERS=5
UVICORN_WORKERS=1
HAILIANG_LLM_RATE_LIMIT_QPS=5
HAILIANG_LLM_RATE_LIMIT_CAPACITY=1
HAILIANG_LOG_DIR=/var/lib/hailiang-skills/test-next/logs
HAILIANG_STATE_DIR=/var/lib/hailiang-skills/test-next/runtime
HAILIANG_SSE_RECORDING_ENABLED=true
HAILIANG_SSE_RECORDING_ROOT_DIR=/var/lib/hailiang-skills/test-next/logs/sse_recording/sessions
HAILIANG_LOCAL_SESSION_CACHE_ENABLED=true
HAILIANG_AUDIT_RAW_CONTENT_ENABLED=false
HAILIANG_AUDIT_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_32_BYTE_BASE64URL_KEY
HAILIANG_AUDIT_KEY_ID=test-next
HAILIANG_SECURITY_QUARANTINE_KEY=REPLACE_WITH_DISTINCT_32_BYTE_BASE64URL_KEY
HAILIANG_SECURITY_ADMIN_TOKEN=REPLACE_TEST_NEXT_ADMIN_TOKEN
ALIBABA_CLOUD_ACCESS_KEY_ID=REPLACE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=REPLACE
ALIYUN_SECURITY_REGION=cn-hangzhou
ALIYUN_SECURITY_ENDPOINT=green-cip.cn-hangzhou.aliyuncs.com
DASHSCOPE_API_KEY=REPLACE
HAILIANG_TEST_LLM_ENABLED=false
AGENT_SKILL_RUNTIME_CORE_PATH=/opt/agent-skill-runtime-core
PYTHONPATH=/opt/hailiang-skills/current-test-next/src:/opt/agent-skill-runtime-core
