#!/usr/bin/env bash
# Copy to ../../env.8010.sh (or another private file), replace every REPLACE_*
# value, then chmod 600 the copied file.  Never commit the copied file.

export HAILIANG_DEPLOY_ENV=test
export HAILIANG_RELEASE_VERSION=4.11.0.1-smoke
export HAILIANG_BIND_HOST=REPLACE_PRIVATE_IP
export BACKEND_PORT=8010
export WORKBENCH_PORT=8020
# Needed only with deploy-smoke.sh --with-frontend.
export HAILIANG_FRONTEND_BIND_HOST=REPLACE_PRIVATE_IP
export FRONTEND_PORT=5177
export HAILIANG_PUBLIC_API_BASE_URL=http://REPLACE_PRIVATE_IP:8010
# The smoke script appends the frontend origin automatically.
export HAILIANG_CORS_ORIGINS=

# Fixed disposable database for smoke deployments. deploy-smoke.sh creates it
# once when it does not exist, and reuses it on subsequent deployments.
export HAILIANG_DATABASE_URL='postgresql+psycopg://hailiang_test:REPLACE_DB_PASSWORD@127.0.0.1:5432/hailiang_skills_test_multi_profile_v1_smoke'
# PostgreSQL administrator URL (database name may be postgres). It is used
# only to create the smoke database or when --reset-database is requested.
export HAILIANG_DATABASE_ADMIN_URL='postgresql+psycopg://postgres:REPLACE_ADMIN_PASSWORD@127.0.0.1:5432/postgres'
export HAILIANG_STORAGE_BACKEND=postgres
export HAILIANG_REDIS_URL='redis://127.0.0.1:6379/3'
export HAILIANG_REDIS_KEY_PREFIX='hailiang:smoke:'

# Generate two independent values on the server with:
# python3.11 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
export HAILIANG_AUDIT_ENCRYPTION_KEY='REPLACE_AUDIT_KEY'
export HAILIANG_AUDIT_KEY_ID='smoke'
export HAILIANG_SECURITY_QUARANTINE_KEY='REPLACE_QUARANTINE_KEY'

export DASHSCOPE_API_KEY='REPLACE_DASHSCOPE_KEY'

# Test-only alternate model routing; production must keep this disabled.
export HAILIANG_TEST_LLM_ENABLED='false'
export HAILIANG_TEST_LLM_USER_IDS='100228,100227,100226,100225,100224,100223,100222,100221,100220,100219'
export HAILIANG_TEST_LLM_BASE_URL='https://ws-cf2bl5wfrmj77y71.cn-beijing.maas.aliyuncs.com/compatible-mode/v1'
export HAILIANG_TEST_LLM_API_KEY='REPLACE_TEST_LLM_KEY'
export HAILIANG_TEST_LLM_MODEL='qwen3.7-plus'
export ALIBABA_CLOUD_ACCESS_KEY_ID='REPLACE_ALIBABA_KEY_ID'
export ALIBABA_CLOUD_ACCESS_KEY_SECRET='REPLACE_ALIBABA_SECRET'
export ALIYUN_SECURITY_REGION='cn-hangzhou'
export ALIYUN_SECURITY_ENDPOINT='green-cip.cn-hangzhou.aliyuncs.com'

export AGENT_SKILL_RUNTIME_CORE_PATH='/home/hljy/Project/hailiang-skill_sensitive_v02121/agent_skill_runtime_core'
export HAILIANG_SMOKE_VENV_DIR='/home/hljy/Project/hailiang-skill_sensitive_v02121/hailiang-skills/.venv-smoke-8010'
export HAILIANG_RUNTIME_DIR='/home/hljy/Project/hailiang-skill_sensitive_v02121/hailiang-skills/runtime-smoke-8010'
export HAILIANG_LOG_DIR='/home/hljy/Project/hailiang-skill_sensitive_v02121/hailiang-skills/logs-smoke-8010'
